{% extends 'base.html.twig' %}

{# surcharge du du bloc title en utilisant le {{ parent() }} #}
{% block title %}{{ parent() }}Homepage{% endblock %}

{% block header %}
<navbar>
    {# toujours en absolu par rapport à template #}
    {% include 'public/inc/menu.html.twig' %}
</navbar>
<div class="example-wrapper">
    {# affichage de variables #}
    <h1>Salut {{ nom }} {{ controller_name }}! ✅</h1>


{% endblock %}
{% block main %}
    {# failles xss protégées par défault dans Symfony, (twig sans symfony xss|e ou xss|escape)
     sinon on ajoute |raw #}
    {{ xss }} | {{ monJS|raw }}

    This friendly message is coming from:


{% endblock %}
{% block footer %}

</div>
{% endblock %}

{# l'ordre des blocks ne doit pas être respecté, sauf sous-ensemble #}
{% block language %}fr{% endblock %}
